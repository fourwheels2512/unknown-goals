{
 "pre_registration": "FOURTH SITTING, pre-registered 2026-09-06 before any of its footage exists. A fresh placement draw (seeds 17,19,31,47,73,89; the first draw tried, not selected among draws). The engine setting, the sense model (v3) and the room rules below are fixed now. The third sitting's 33/36 was measured on sense model v2 as pre-registered; v3 was then chosen on the second and third sittings' graded footage (development numbers, disclosed in docs/PHONE_PROTOCOL.md) and is therefore a development choice tested for the first time by this sitting. Nothing changes after the clips exist.",
 "scope": "This is a PERCEPTION-AND-COGNITION test on real camera pixels, NOT a robot result. Nothing moves: a person carries a phone to six fixed zones in one room and records a short clip of each. The engine chooses which zone's clip to look at next, accumulates OBSERVED and ABSENT_FROM claims, and commits to a zone. No navigation, no manipulation, no autonomy over a physical body is claimed or measured.",
 "generator": "scripts/make_phone_manifest.py",
 "placement_sha256": "50e019990255fcb9ca29c1078aec946aee0e3ab2da11965fbce46555a205f717",
 "tips_sha256": "987de4d9fd07fa646673afa51f70d55533fef3eb3bbd8e31f99607577ac27b3d",
 "protocol": {
  "room": "one room, six fixed zones, recorded by hand",
  "zones": [
   {
    "zone": 1,
    "name": "green sofa"
   },
   {
    "zone": 2,
    "name": "black desk"
   },
   {
    "zone": 3,
    "name": "kitchen island"
   },
   {
    "zone": 4,
    "name": "marble table"
   },
   {
    "zone": 5,
    "name": "blue bin"
   },
   {
    "zone": 6,
    "name": "navy bench"
   }
  ],
  "targets": [
   "Mug",
   "Book",
   "RemoteControl",
   "CellPhone",
   "Bottle",
   "Bowl"
  ],
  "seeds": [
   17,
   19,
   31,
   47,
   73,
   89
  ],
  "rounds": 6,
  "clips_total": 36,
  "episodes_total": 36,
  "placement_rule": "random.Random(seed).shuffle([1..6]); the shuffled list read off against targets in their fixed manifest order",
  "recording_order": "ALWAYS zone 1 -> 2 -> 3 -> 4 -> 5 -> 6, in every round, regardless of where anything was placed. Fixed order is what stops the recording order from leaking placement.",
  "clip_seconds": [
   3,
   5
  ],
  "camera": {
   "hand_held": true,
   "distance_m": 1.0,
   "resolution": "1080p",
   "motion": "slow pan across the zone"
  },
  "file_naming": "seed{SS}_zone{Z}.mp4, e.g. seed07_zone3.mp4",
  "footage_dir": "data/phone_s4/",
  "re_record_rule": "If an object will not sit in its zone, or is knocked over, or the clip is unusable: re-record THAT clip with the object in the zone the manifest names. Never improvise a different placement, never skip a zone, never reorder."
 },
 "detector": {
  "model": "YOLO-World yolov8x-worldv2 (sense model v3: the same weights and prompt list as v2, one label per object at scope 'all', target synonym groups folded into the per-clip maxima)",
  "weights": "/root/yolo/yolov8x-worldv2.pt",
  "imgsz": 1088,
  "vocabulary": "the fixed 62-class THOR_PICKUPABLE_TYPES prompt list plus the phone battery's aliases and distractor prompts (robot_mind.adapters.phone_vocab, unchanged from v2)",
  "detect_conf": 0.02,
  "claim_min_conf": 0.05,
  "frame_stride": 10,
  "iou_gate": null,
  "iou_disclosure": "No IoU / instance-association gate. Every simulator run binds a detection to a rendered instance mask before it may become a claim, which makes detector hallucinations incapable of creating a sighting. Real footage has no instance masks, so that gate is absent here: a hallucinated detection CAN produce a false sighting and a wrong commitment. That is the point of the test - it is strictly harder than the simulator batteries on precisely the axis reviewers doubt."
 },
 "arms": [
  "engine",
  "sweep",
  "random"
 ],
 "grading": "An episode is CORRECT when the engine's committed zone equals truth_zone. A commitment to any other zone is WRONG (it is not a miss). No commitment inside the visit budget is a MISS. Wrong commitments and misses are reported separately.",
 "engine_unchanged": "The engine is used unmodified; only the sense model in experiments/embodied/phone_find.py is new.",
 "tips": {
  "pre_registration": "TIP COINS, fixed before any footage: for every (seed, target) episode the tip is TRUE (names the truth zone) or FALSE (names one wrong zone), balanced three and three per round. Tips need no recording: a tip is a REPORTED claim written to the engine's ledger before the search, the same front door the hospital and warehouse tips used. The base clips serve unchanged. Committed BEFORE any clip was run through the detector, so coins could not have been placed where the detector happens to be strong or weak.",
  "rule": "random.Random(f'phonetip_{seed}').shuffle(targets); first half TRUE (tip_zone = truth_zone), second half FALSE (tip_zone drawn from the five wrong zones with the same generator, in shuffle order)",
  "tip_confidence": 0.75,
  "tip_status": "REPORTED",
  "harness": "experiments/embodied/phone_tips.py",
  "arms": [
   "engine",
   "sweep",
   "tipfollow"
  ],
  "grading": "Correctness as above, per arm and per tip cell (TRUE n=18, FALSE n=18). Visits are reported per cell: a TRUE tip should be worth one visit to any policy that uses it; a FALSE tip measures how much a policy pays for trusting it. Uniform prior otherwise, so the only efficiency statement is the paired per-cell comparison, never an overall one.",
